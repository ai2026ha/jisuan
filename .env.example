# 复制为 .env 后修改。不要把真实 .env 上传到公开仓库。
POSTGRES_DB=agent_calculator
POSTGRES_USER=agent_calc
POSTGRES_PASSWORD=请改成高强度数据库密码
SESSION_SECRET=请改成至少32字节随机字符串
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成高强度管理员密码

# HTTP 首次部署填 0；启用 HTTPS 后改为 1，然后重启 app。
SESSION_COOKIE_SECURE=0

# 一般无需修改。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# 网页上传备份大小限制（一般无需修改）。
BACKUP_UPLOAD_MAX_MB=100
BACKUP_JSON_MAX_MB=300
